# Copy to .env.nightly (gitignored) and fill in real values.
# Sourced by run_nightly.sh before each scan; used for SMTP login and
# failure-notification email.
#
# Generate a Gmail app password: https://myaccount.google.com/apppasswords

JOB_SEARCH_SMTP_USER=your_gmail_address@gmail.com
JOB_SEARCH_SMTP_PASS=your_16_char_app_password

# Optional: override the default CV directory (<repo>/cvs)
# JOB_SEARCH_CV_DIR=/path/to/your/cvs
